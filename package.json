{
  "name": "tradingview-mcp",
  "version": "1.5.0",
  "description": "MCP bridge for TradingView Desktop via Chrome DevTools Protocol",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "src/server.js",
  "bin": {
    "tv": "src/cli/index.js"
  },
  "exports": {
    ".": "./src/server.js",
    "./core": "./src/core/index.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "tv": "node src/cli/index.js",
    "lint": "eslint src/",
    "test": "node scripts/test.js",
    "test:e2e": "node scripts/test.js --suite e2e",
    "test:e2e:replay": "node scripts/test.js --suite e2e --replay --pattern replay_",
    "test:e2e:replay-trading": "node scripts/test.js --suite e2e --replay --replay-trading --pattern replay_",
    "test:unit": "node scripts/test.js --suite unit",
    "test:cli": "node scripts/test.js --module cli",
    "test:errors": "node scripts/test.js --module errors",
    "test:durable": "node scripts/test.js --module strategy/run",
    "benchmark:strategy-durable": "node scripts/strategy-durable-benchmark.js",
    "test:all": "node scripts/test.js --suite local",
    "test:verbose": "node scripts/test.js --reporter spec",
    "test:count": "node scripts/test.js --suite e2e --reporter spec",
    "release:check-version": "node scripts/release.js check-version",
    "release:print-tag": "node scripts/release.js print-tag",
    "test:compatibility": "node scripts/test.js --module compatibility",
    "test:integration": "node scripts/test.js --suite integration",
    "test:module": "node scripts/test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "chrome-remote-interface": "^0.33.2"
  },
  "devDependencies": {
    "eslint": "^9.39.4"
  }
}
